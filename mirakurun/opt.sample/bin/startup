#!/bin/sh

INITIALIZED_FPATH="/opt/initialized"
APT_INSTALL="apt install -y --no-install-recommends"

apt_update() {
    apt-get -y update
}

install_depends() {
    ${APT_INSTALL} \
        autoconf \
        cmake \
        libpcsclite1 \
        libpcsclite-dev \
        pkg-config \
        git \
        automake \
        libtool
}

install_libyakisoba() {
    ## libyakisoba
    git clone https://github.com/tsunoda14/libyakisoba.git /opt/libyakisoba
    cd /opt/libyakisoba || return 1
    autoreconf -i
    mkdir -p /opt/libyakisoba/build
    cd /opt/libyakisoba/build || return 1
    ../configure
    make
    make install
    return 0
}

install_libsobacas() {
    ## libsobacas
    git clone https://github.com/tsunoda14/libsobacas.git /opt/libsobacas
    cd /opt/libsobacas || return 1
    autoreconf -i
    mkdir -p /opt/libsobacas/build
    cd /opt/libsobacas/build || return 1
    ../configure
    make
    make install
    return 0
}

install_libaribb25() {
    # libaribb25
    git clone https://github.com/tsukumijima/libaribb25.git /opt/libaribb25
    cd /opt/libaribb25 || return 1
    cmake . -B build -DWITH_PCSC_PACKAGE=NO -DWITH_PCSC_LIBRARY=sobacas
    make -C build
    make -C build install
    return 0
}

install_recpt1() {
    # recpt1
    if (type "recpt1" > /dev/null 2>&1); then
        return 0
    fi

    git clone --depth=1 https://github.com/stz2012/recpt1.git /src/recpt1
    cd /src/recpt1/recpt1 || return 1
    ./autogen.sh
    ./configure --enable-b25
    make
    make install
    return 0
}

set_initialized() {
    touch "${INITIALIZED_FPATH}"
}

check_initialized() {
    if [ ! -e "${INITIALIZED_FPATH}" ]; then
        return 1
    fi

    return 0
}


# 初期セットアップ
if check_initialized; then
    # 初期セットアップ済み
    exit 0
fi

# 依存関係をインストール
apt_update
install_depends

# アプリを手動インストール
install_libyakisoba
install_libsobacas
install_libaribb25
install_recpt1

set_initialized

exit 0
